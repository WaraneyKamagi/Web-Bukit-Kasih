# ==========================================
# KONFIGURASI DATABASE & KEAMANAN DASAR
# ==========================================
# (OPSIONAL) Driver database, default: postgres
DB_DRIVER=postgres
# (WAJIB) URL Koneksi Database PostgreSQL
DB_SOURCE=postgres://user:password@host:port/dbname
# (WAJIB) Kunci Rahasia untuk enkripsi dan penandatanganan JWT
JWT_SECRET=super_secret_key_anda

# ==========================================
# KONFIGURASI SERVER & DEPLOYMENT
# ==========================================
# (OPSIONAL) Mode operasi Gin (set "release" di environment server produksi)
GIN_MODE=debug
# (OPSIONAL) Port jalannya aplikasi backend (default: 8080)
PORT=8080
# (OPSIONAL) URL asal Frontend untuk mengizinkan (bypass) sekuritas CORS
FRONTEND_URL=http://localhost:5173

# ==========================================
# KONFIGURASI ALAT BANTU (TOOLING) / INITIAL
# ==========================================
# (OPSIONAL) Set ke "true" untuk migrasi/pembaruan struktur tabel ke versi terbaru secara otomatis
AUTO_MIGRATE=false
# (OPSIONAL) Set ke "true" untuk mengisi tabel dengan data default (seperti pembuatan akun Dummy)
# PERINGATAN: JANGAN diset 'true' di production secara sembarangan!
SEED_DATA=false

# ==========================================
# KREDENSIAL LAYANAN PIHAK KETIGA (AI & CHAT)
# ==========================================
# (WAJIB) Kunci API Groq (LLM) untuk fitur Chatbot Pintar
GROQ_API_KEY=gsk_tulis_api_key_disini
# (OPSIONAL) Versi LLM Groq (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
# (WAJIB) Token bot Telegram yang didapatkan dari BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxyz
# (OPSIONAL) ID Chat Telegram milik pengelola wisata (untuk peringatan pesan/inquiry)
TELEGRAM_ADMIN_CHAT_ID=123456789
