# URL Endpoint Backend (Go API)
# Gunakan nilai kosong atau '/' jika backend dan frontend di-deploy dalam satu domain (misalnya menggunakan Vercel Rewrites atau Nginx Reverse Proxy).
# Jika backend di-deploy terpisah (misalnya Render) dan frontend di Vercel, isi dengan URL absolut lengkap, misal: https://api.bukitkasih.com/api/v1
VITE_API_URL=/api/v1

# Konfigurasi Supabase (Untuk fitur real-time pengumuman)
# Kredensial ini bersifat publik (anon key), dapat diekspos di frontend.
VITE_SUPABASE_URL=https://<PROYEK_ANDA>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
